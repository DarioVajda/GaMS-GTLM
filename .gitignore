.venv
**/__pycache__
**/*.pyc

# secrets / login helpers (contain tokens)
hf_token.txt
hf_login.sh
wandb_login.sh

# raw data (83 GB: the CJVT KG zip + extracted N-Triples) — never commit
data/kg_raw/

# training / experiment artifacts
checkpoints
wandb
job_logs/
**/*.pth
*.gtds/
*.gtds.lock
.inductor_cache/
**/_inductor_cache/

# packaging
*.egg-info/
/build/
/dist/

# editor / OS
.DS_Store

# assistant context (private)
CLAUDE_CONTEXT.md
CLAUDE.md
TODO.md

# built artefacts: the store (~4 GB), and everything the pipeline generates from
# it -- the dataset, the two baseline inputs, the intermediates under work/, and
# the one-slot rollback in previous/.  `reference/` is NOT ignored -- it is
# small, and it is an input.
data/stores/kg_graph_*/
data/datasets/generated/
data/datasets/balls/
data/datasets/balls_serialised/
data/datasets/balls_noretrieval/
data/datasets/work/
data/datasets/previous/

# kept corpora, one directory per build worth going back to (~210 MB each,
# including the extraction dump without which stage 3 cannot be re-derived).
# `previous/` is a single rotating slot the next publish overwrites; this is
# where a corpus goes when it has results attached to it.
data/datasets/archive/

train/results/

data/analysis/results/*_items.part*.jsonl

# slurm job logs, all of them.  Every file here is job output: the GPU training
# logs run 80 KB - 700 KB apiece (tqdm writes a progress bar per step) and the
# CPU pipeline logs are small but equally reproducible -- rerunning the job that
# wrote one is the way to get it back.  Kept on disk, out of the repo.
data/logs/
