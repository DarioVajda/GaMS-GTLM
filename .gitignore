.venv
**/__pycache__
**/*.pyc

# secrets / login helpers (contain tokens)
hf_token.txt
hf_login.sh
wandb_login.sh

# raw data (83 GB: the CJVT KG zip + extracted N-Triples) — never commit
data/kg_raw/

# training / experiment artifacts
checkpoints
wandb
job_logs/
**/*.pth
*.gtds/
*.gtds.lock
.inductor_cache/
**/_inductor_cache/

# packaging.  Anchored with a leading slash so they match ONLY at the repo root:
# unanchored, `build/` also matches data/build/ (the graph-store pipeline) and
# silently drops the whole directory from the repo.
*.egg-info/
/build/
/dist/

# editor / OS
.DS_Store

# assistant context (private)
CLAUDE_CONTEXT.md

# persisted graph stores: ~4 GB each, rebuildable from kg_raw in ~35 min.  One
# pattern covers every variant, present and future -- v3, v3_1, v4, and whatever
# comes next.  The suffix is the tokenizer that filled token_len (_gemma3 is
# what `lookup` and downstream work read; _gams2b differs only in token_len).
data/stores/kg_graph_*/

# the reference lexicographical QA datasets -- an internal sample, NOT public
# (see README "Data").  Committing them would publish them via GitHub.
data/datasets/reference/Lexical-QA-SLO*

# generated QA corpora and extracted balls: 167 MB today, and REBUILT whenever a
# policy changes -- balls/v2 alone is 73 MB, so every rebuild would leave another
# permanent blob in history.  Same reasoning as the stores above: they are a pure
# function of (store, qa/, seed), reproducible in ~1 h by
# qa/run_generate.sbatch -> analysis/run_extract_sharded.sbatch ->
# qa/run_relabel.sbatch -> qa/run_build_balls.sbatch.
data/datasets/generated/
data/datasets/balls/

# sweep output: generated per-config job scripts, slurm logs, the runs record and
# the per-item prediction dumps.  One 12-run sweep is 16 MB and ~49,500 lines,
# and every sweep writes another.  The FINDINGS belong in train/README.md, which
# is the thing worth reading and reviewing; this tree is the scratch it came from.
# (train/results/train_runs.jsonl predates this rule and stays tracked.)
train/results/

# slurm logs from GPU training jobs.  tqdm writes a progress bar per step, so
# these run 80 KB - 700 KB each while the informative part is a few dozen lines.
# The CPU pipeline logs -- qa_balls_*, qa_variants_* -- stay tracked: they are
# ~20 lines apiece and are the record of how a dataset was actually built.
data/logs/sl_qa_smoke_*.out
data/logs/sl_qa_timing_*.out
data/logs/len_stats_*.out

CLAUDE.md
