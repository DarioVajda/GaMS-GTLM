#!/usr/bin/env bash
# `ask ...` -> the ask/ package, from any working directory.
#
#     ask "Kaj pomeni beseda brahialen?"
#     ask -i
#     ask --demo -i --fast          # no GPU, no weights, simulated timings
#
# Put this directory on PATH once:
#     echo 'export PATH="/shared/workspace/povejmo/gams_gtlm/bin:$PATH"' >> ~/.bashrc
#
# This script exists to own ONE seam (D13).  `train` is pip-installed and
# resolves from the repo root; `qa` and `lib` resolve only with `data/` on the
# path, and pyproject.toml deliberately refuses to install them -- names as
# generic as `build` and `lib` do not belong on the global import path.  `ask`
# is the first thing that needs both, so both go on PYTHONPATH here, in one
# readable line, and no module does sys.path surgery.
#
# Interpreter choice, in one place.  `ask` needs more than `lookup` does: the
# store side wants numpy, and the model side wants torch, transformers, peft and
# `gtlm` -- and only THIS repo's venv carries all four (graph_model's has no
# `gtlm`, and a node's /usr/bin/python3 has none of it).  So the repo venv is
# preferred, with the same node-dependence caveat bin/lookup documents; --demo
# skips the whole question, since it runs on the standard library alone.
set -euo pipefail

here=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
repo=$(dirname -- "$here")

[ -d "$repo/ask" ] || { echo "ask: missing $repo/ask" >&2; exit 127; }

# A self-contained copy of this tree -- one staged for people who cannot read
# the povejmo workspace -- is recognised by carrying its own `hf/`.  In one, the
# umask is relaxed to 022, and it must happen HERE, above everything that runs a
# python: the interpreter probe below imports numpy and torch, which writes
# several hundred `__pycache__` files, and under the default 027 every one of
# them lands unreadable to the next person.  Same reason the shared
# `ask/cache/<gpu>` needs it -- what one session compiles, the next must read.
shared_copy=0
[ -d "$repo/hf" ] && { shared_copy=1; umask 022; }

demo=0
for a in "$@"; do [ "$a" = "--demo" ] && demo=1; done

works() { "$1" -c 'import numpy, torch, gtlm' >/dev/null 2>&1; }

py=${KG_PYTHON:-}
if [ -z "$py" ]; then
    if [ "$demo" = 1 ]; then
        py=python3
    elif works "$repo/.venv/bin/python"; then
        py="$repo/.venv/bin/python"
    else
        # Node-dependent fallback: pick_python.sh finds a 3.10 that can see the
        # shared venv's site-packages on THIS node.
        picker="$repo/data/lib/pick_python.sh"
        if [ -x "$picker" ] && py=$("$picker" 2>/dev/null) && [ -n "$py" ] \
           && works "$py"; then
            :
        else
            echo "ask: no python on this node can import numpy, torch and gtlm." >&2
            echo "     On a Blackwell host (python3.12) use the container:" >&2
            echo "     sbatch $repo/ask/slurm/run_ask.sbatch ARGS..." >&2
            echo "     Or set KG_PYTHON to an interpreter that can." >&2
            exit 127
        fi
    fi
fi

# The extractor (cjvt/GaMS3-12B-Instruct) lives in the shared cache, not in
# ~/.cache -- data/analysis/extract_in_container.sh points there for the same
# reason.  Only a default: an HF_HOME already in the environment wins.
#
# A self-contained copy of this tree carries its own `hf/` and that wins over the
# shared cache -- the povejmo workspace is mode 2770 and root-owned, so a copy
# staged for someone outside the group cannot read it.  Such a copy is offline by
# construction (nothing else is downloadable into it), so HF_HUB_OFFLINE goes
# with it: without it every load pays a hub round-trip that can only time out.
#
# `shared_copy` is decided at the top, where it also sets the umask -- the two
# uses are the same question asked once.
if [ "$shared_copy" = 1 ]; then
    export HF_HOME="${HF_HOME:-$repo/hf}"
    export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
else
    export HF_HOME="${HF_HOME:-/shared/workspace/povejmo/huggingface_cache}"
fi

# One session asks questions of wildly different sizes -- 1.3 k tokens at the
# median, 14 k at the top -- so the caching allocator ends up holding large
# reserved-but-unusable blocks, and a big ball then OOMs against memory that is
# free.  Measured: the `--precompile` sweep died on shapes it had the room for.
# torch's own remedy, and the one its OOM message names.
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"

# D13's seam, the whole reason this file exists: `train` resolves from the repo
# root and `qa`/`lib` only from `data/`, and pyproject.toml deliberately refuses
# to install the latter two.
export PYTHONPATH="$repo:$repo/data${PYTHONPATH:+:$PYTHONPATH}"
cd -- "$repo"
exec "$py" -m ask "$@"
