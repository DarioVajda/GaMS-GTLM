{
  // ─────────────────────────────────────────────────────────────────────────
  // scale_12b_probe8 — how long does a 12B step actually take, on 8 GPUs?
  //
  //     .venv/bin/python -m sweep train train/configs/scale_12b_probe8.jsonc
  //
  // The 8-GPU twin of `scale_12b_probe4.jsonc`.  Read together the pair gives
  // the DDP scaling factor on this model: only the LoRA adapters and the
  // graph-bias tensors are reduced (a few tens of MB, not 12 B parameters), so
  // the reduction should be nearly free and the pair says whether it is.
  //
  // At 8 ranks the effective batch of 16 factorises to `2 x 1 x 8` -- the
  // micro-batch has to fall to 2, which is the point where per-step overhead
  // starts to matter and is exactly why this is measured rather than assumed.
  //
  // A run from this config has NO result and must never be read as one.
  // ─────────────────────────────────────────────────────────────────────────
  "name": "scale_12b_probe8",
  "results_dir": "train/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 1,
      "partition": "frida",
      "account": "lkm",
      "gpus": ["B200", "B300"],
      "gpus_per_config": 8,
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh",
      "mounts": "/shared:/shared",
      "cpus": 64,
      "mem": "512G",
      "time": "02:00:00"
    }
  },

  "mode": "train",
  "model_name": "cjvt/GaMS3-12B-Instruct",
  "types": "",
  "items_root": "data/datasets/generated",

  "arm": [
    {"data_root": "data/datasets/balls", "plain_llm": false, "spd": true, "magnetic": true, "max_length": 2048, "batch_size": 4, "accumulation_steps": 4}
  ],
  "seed": 0,

  "rrwp": false,
  "max_spd": 8,
  "magnetic_dim": 32,
  "magnetic_q": 0.25,
  "magnetic_m": 0,
  "k_hop": 0,

  "impl": "v2-flex",
  "flex_compile_mode": "default",
  "flex_cache_size_limit": 512,
  "dtype": "bf16",
  "lora": true,
  "lora_r": 32,
  "lr": 5e-4,
  "bias_lr": 1e-2,

  "train_token_budget": 0,
  "num_epochs": 1,
  "max_steps": 30,
  "eval_steps": 25,
  "eval_max_batch": 16,
  "dev_subsample": 0.1,
  "num_workers": 4,
  "final_eval": false
}
