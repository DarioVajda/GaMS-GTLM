{
  // ─────────────────────────────────────────────────────────────────────────
  // arms_v3 — the encoding/retrieval ablation, six configurations x three seeds.
  //
  //     .venv/bin/python -m sweep train train/configs/arms_v3.jsonc
  //
  // ONE file, ONE sweep call, ONE Slurm array, ONE runs.jsonl.  The four split
  // `arms_v3fc_*` / `arms_v3p_*` drafts this replaces existed only because the
  // GPU tiers differed; everything is on B200 now, so the split has no reason to
  // exist and a single file removes the "change it in three places or the arms
  // stop being comparable" hazard.
  //
  //   #  configuration              input                       stack  biases
  //   1  GTLM (spd + magnetic)      balls/v2_clean              gtlm   spd+magnetic
  //   2  GTLM, no bias              balls/v2_clean              gtlm   none
  //   3  serialised — GTLM stack    balls/v2_clean_serialised   gtlm   none
  //   4  serialised — plain stack   balls/v2_clean_serialised   plain  n/a
  //   5  no retrieval — plain stack balls/v2_clean_noretrieval  plain  n/a
  //   6  no retrieval — GTLM stack  balls/v2_clean_noretrieval  gtlm   none
  //
  // Arms 3-6 ship balls with ZERO graph nodes -- the subgraph is flattened into
  // the prompt (3, 4) or absent entirely (5, 6) -- so arms 4 and 5 differ in
  // exactly one thing: whether the graph's text is in the prompt.
  //
  // The contrasts this design answers (train/analysis/report_arms.py reports each of them
  // PAIRED BY SEED):
  //
  //   Retrieval        4 vs 5   is the subgraph worth anything at all
  //   Structural bias  1 vs 2   does the bias make the graph usable
  //   Graph encoding   1 vs 3   THE HEADLINE — encoding, stack held fixed
  //   Stack cost       3 vs 4   what SDPA + sliding_window=512 buys on a long input
  //   Stack control    5 vs 6   the same stack difference where it CANNOT act (~0)
  //
  // Why the stack is worth three runs: serialised prompts are p50 2,166 / p99
  // 10,014 tokens and stock Gemma-3 applies `sliding_window=512` in 22 of its 26
  // layers, which `GTLMGemma3ForCausalLM` drops.  That is a large capability
  // difference sitting directly on top of the encoding claim, and without arm 3
  // there is no way to tell the two apart.  Arm 6 is a negative CONTROL, not a
  // fifth measurement: the no-retrieval input is p50 ~35 tokens and max well
  // under 512, so the window cannot bite -- if arms 5 and 6 do not land on top of
  // each other, contrast 4 is not measuring the window and the reading of
  // contrast 3 has to change.
  //
  // What this replaces (arms_v2, and why its numbers are unusable):
  //   1. nothing converged -- 3 epochs, dev accuracy still rising in every arm,
  //      best checkpoint the LAST one in all 12 runs;
  //   2. the arms were not running the same optimisation -- under token-budget
  //      batching the item count per batch fell out of sequence length, giving a
  //      6x spread in both effective batch and update count across arms;
  //   3. two grading contracts were wrong and were repaired post hoc.
  // All three are fixed here; see TODO.md and train/README.md.
  // ─────────────────────────────────────────────────────────────────────────
  "name": "arms_v3",
  "results_dir": "train/results",

  "execution": {
    "mode": "sbatch",
    "sbatch": {
      "granularity": "per_config",
      "max_concurrent": 18,
      "partition": "frida",
      "account": "lkm",
      "gpus": ["H100", "B200", "B300"],
      "container": "/shared/workspace/povejmo/containers/transformers_deepspeed_latest.sqsh",
      "mounts": "/shared:/shared",
      "cpus": 8,
      "mem": "128G",
      "time": "16:00:00"
    }
  },

  "mode": "train",
  "model_name": "google/gemma-3-1b-it",
  "types": "",
  "items_root": "data/datasets/generated/v2_clean",

  "arm": [
    {"data_root": "data/datasets/balls/v2_clean",             "plain_llm": false, "spd": true,  "magnetic": true,  "max_length": 2048,  "batch_size": 4,  "accumulation_steps": 4},
    {"data_root": "data/datasets/balls/v2_clean",             "plain_llm": false, "spd": false, "magnetic": false, "max_length": 2048,  "batch_size": 4,  "accumulation_steps": 4},
    {"data_root": "data/datasets/balls/v2_clean_serialised",  "plain_llm": false, "spd": false, "magnetic": false, "max_length": 17408, "batch_size": 4,  "accumulation_steps": 4},
    {"data_root": "data/datasets/balls/v2_clean_serialised",  "plain_llm": true,  "spd": false, "magnetic": false, "max_length": 17408, "batch_size": 4,  "accumulation_steps": 4},
    {"data_root": "data/datasets/balls/v2_clean_noretrieval", "plain_llm": true,  "spd": false, "magnetic": false, "max_length": 2048,  "batch_size": 16, "accumulation_steps": 1},
    {"data_root": "data/datasets/balls/v2_clean_noretrieval", "plain_llm": false, "spd": false, "magnetic": false, "max_length": 2048,  "batch_size": 16, "accumulation_steps": 1}
  ],
  "seed": [0, 1, 2],

  "rrwp": false,
  "max_spd": 8,
  "magnetic_dim": 32,
  "magnetic_q": 0.25,
  "magnetic_m": 0,
  "k_hop": 0,

  "impl": "v2-flex",
  "flex_compile_mode": "default",
  "flex_cache_size_limit": 512,
  "dtype": "bf16",
  "lora": true,
  "lora_r": 32,
  "lr": 5e-4,
  "bias_lr": 1e-2,
  "train_token_budget": 0,
  "num_epochs": 8,
  "eval_steps": 400,
  "eval_max_batch": 16,
  "dev_subsample": 0.5,
  "num_workers": 4
}
